# Use the PostgreSQL connection string supplied for your environment.
DATABASE_URL=postgresql://user:password@localhost:5432/schemesetu

# Used only by the API server; keep the real value in Replit Secrets.
GEMINI_API_KEY=your-gemini-api-key

# Session signing secret. If unset, SESSION_SECRET is used instead.
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret
